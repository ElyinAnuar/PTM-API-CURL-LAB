    {
      "name": "Login Supervisor",
      "item": [
        {
          "name": "03 Login",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "////////////////////////////////Data Terminal////////////////////////////////\r",
                  "\r",
                  "let SelectData = JSON.parse(pm.environment.get(\"V_SELECT_TERMINAL\"));\r",
                  "\r",
                  "////////////////////////////////Seteamos los valores/////////////////////////\r",
                  "\r",
                  "let requestBody = {\r",
                  "    BrowserName: \"InternetExplorer\",\r",
                  "    BrowserPlataform: \"WinNT\",\r",
                  "    ConectorID: SelectData.ConectorID,\r",
                  "    DatetimeConfig: \"20260409093204855\",\r",
                  "    DollaAccount: SelectData.DollaAccount,\r",
                  "    HostName: \"products.airpak-services.com\",\r",
                  "    IpAddress: \"127.0.0.1\",\r",
                  "    LocalAccount: SelectData.LocalAccount,\r",
                  "    MacAddress: \"MacAddress\",\r",
                  "    TerminalID: SelectData.TerminalID\r",
                  "}\r",
                  " \r",
                  "pm.environment.set(\"V_USER_JSONCOOKIE\", encodeURIComponent(JSON.stringify(requestBody)));\r",
                  "\r",
                  "\r",
                  "\r",
                  "\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Cargamos el response\r",
                  "let jsonData = pm.response.json();\r",
                  "\r",
                  "pm.environment.set(\"V_INDEX_JSONCOOKIE\", JSON.stringify(jsonData));"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "https://ca-aposng-api-ws.{{nginx}}.airpak-services.com/api/Login/Index?jsoncookie={{V_USER_JSONCOOKIE}}",
              "protocol": "https",
              "host": [
                "ca-aposng-api-ws",
                "{{nginx}}",
                "airpak-services",
                "com"
              ],
              "path": [
                "api",
                "Login",
                "Index"
              ],
              "query": [
                {
                  "key": "jsoncookie",
                  "value": "{{V_USER_JSONCOOKIE}}"
                }
              ]
            }
          },
          "response": []
        }
